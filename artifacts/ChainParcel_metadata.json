		"userdoc": {
			"kind": "user",
			"methods": {
				"assignCourier(uint256,address)": {
					"notice": "VULNERABILITY 1: Access Control Vulnerability (OWASP SC01) ------------------------------------------------------------ This function is meant to be restricted to the logistics company (owner), but the onlyOwner modifier is intentionally left off. Any address can assign itself (or anyone else) as the courier for any shipment. Combined with updateStatus() below (which also lacks a \"msg.sender == s.courier\" check), an attacker can:   1. Call assignCourier(id, attackerAddress)   2. Call updateStatus(id, Status.Delivered)   3. Call releasePayment(id) to steal the escrowed fee      without ever delivering the parcel. Fix (do NOT apply yet - this is intentional for the assignment):   Add `onlyOwner` to assignCourier(), and require   `registeredCouriers[courier] == true`."
				},
				"claimRefund(uint256)": {
					"notice": "VULNERABILITY 2: Reentrancy (OWASP SC05) ------------------------------------------------------------ The external call (sending ETH back to msg.sender) happens BEFORE the state is updated (s.refunded = true / fee = 0). A malicious contract calling this function can re-enter claimRefund() from its receive()/fallback() function and drain the escrowed fee multiple times, taking funds that belong to other shipments' senders and couriers. Fix (do NOT apply yet - this is intentional for the assignment):   Follow checks-effects-interactions: set s.refunded = true   and zero out s.fee BEFORE making the external call, or use   a reentrancy guard (nonReentrant modifier)."
				},
				"updateStatus(uint256,uint8)": {
					"notice": "Also part of VULNERABILITY 1 (OWASP SC01): This function should check `msg.sender == s.courier`, but that check is intentionally omitted so any address can move any shipment straight to Delivered. Fix (do NOT apply yet):   require(msg.sender == s.courier, \"Not assigned courier\");"
				}
			},
			"notice": "ChainParcel - A Blockchain Delivery Tracking and Escrow Contract ACADEMIC NOTE: This contract intentionally contains vulnerabilities from the OWASP Smart Contract Top 10 (2025) for a class assignment. It is built for testing on the Sepolia testnet only, never mainnet. Intentional vulnerabilities:   1. SC01 - Access Control Vulnerability   -> assignCourier(), updateStatus()   2. SC05 - Reentrancy                     -> claimRefund() See the comments marked \"VULNERABILITY\" below for details.",
			"version": 1
		}
